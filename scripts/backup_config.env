# Database Backup Configuration
# Copy this file and modify as needed, then source it before running backup

# Backup directory (default: ./DB_BKP)
BACKUP_DIR=./DB_BKP

# Database configuration
DB_USER=food_nutrition_user
DB_PASSWORD=food_nutrition_pass
DB_NAME=food_nutrition_db
DB_HOST=localhost
DB_PORT=5433

# Docker compose file path
DOCKER_COMPOSE_FILE=docker/docker-compose-prod-deploy.yml

# Optional: Custom backup filename prefix
BACKUP_PREFIX=food_nutrition_backup 